# ============================================================
# Warframe 裂缝监控 —— 配置示例
# 复制为 .env 后填写真实值：  Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，请勿把真实 token / QQ 号提交到仓库。
# ============================================================

# ---------- 数据源（默认即推荐配置，通常无需改动）----------
# official     = Digital Extremes 官方 WorldState（默认，推荐，通常无需代理）
# warframestat = WarframeStat.us（备用，部分网络会被 Cloudflare 403）
# auto         = 先 official，只有请求/解析失败才回退 warframestat
WARFRAME_SOURCE=official

# 官方 WorldState（默认源）。解析使用 warframe-worldstate-parser，locale 固定 en。
WARFRAME_WORLDSTATE_URL=https://api.warframe.com/cdn/worldState.php

# 备用源地址（固定 en locale）
WARFRAMESTAT_API_URL=https://api.warframestat.us/pc/fissures?language=en

# 可选代理：只作用于 Warframe 外部请求，NapCat 请求绝不走代理。
# 一般无需填写；只有本机访问官方 WorldState 需要代理时才设置，例如：
# WARFRAME_PROXY_URL=http://127.0.0.1:7890
# 日志中不会打印带用户名/密码的完整代理地址。
WARFRAME_PROXY_URL=

# ---------- 轮询与日志 ----------
# 轮询间隔（毫秒）。上一轮检查结束后才开始计时，不会任务重叠。
POLL_INTERVAL_MS=60000

# 单次 HTTP 请求超时（毫秒）
HTTP_TIMEOUT_MS=10000

# 心跳日志间隔（毫秒），默认 6 小时。心跳只写日志，绝不发送 QQ。
HEARTBEAT_INTERVAL_MS=21600000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ---------- NapCat / OneBot 11 ----------
NAPCAT_BASE_URL=http://127.0.0.1:3000
# NapCat 配置了 token 才填；留空则不发送 Authorization 头
NAPCAT_TOKEN=
NAPCAT_TIMEOUT_MS=15000

# ---------- 通知目标 ----------
# 接收私聊通知的 QQ 号（纯数字，不要加引号）
TARGET_QQ=

# ---------- 运行控制 ----------
# true = 只检测并打印，不真正发送 QQ 消息（首次验证建议设为 true）
DRY_RUN=false

# 去重状态文件（相对路径基于项目根目录）；
# 单实例锁文件 monitor.lock 会自动放在同一目录
STATE_FILE=data/state.json
