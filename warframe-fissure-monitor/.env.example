# ============================================================
# Warframe 裂缝监控 —— 配置示例
# 复制为 .env 后填写真实值：  Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，请勿把真实 token / QQ 号提交到仓库。
# ============================================================

# Warframe 裂缝数据源（国际服 PC）
WARFRAME_API_URL=https://api.warframestat.us/pc/fissures

# 轮询间隔（毫秒）。默认 60000 = 60 秒。
# 注意：上一轮检查结束后才会等待这个间隔，因此不会出现任务重叠。
POLL_INTERVAL_MS=60000

# NapCatQQ 的 OneBot 11 HTTP 服务地址（不要带结尾斜杠也可以）
NAPCAT_BASE_URL=http://127.0.0.1:3000

# NapCat 的 access token。没有设置就留空（留空时不发送 Authorization 头）。
NAPCAT_TOKEN=

# 接收私聊通知的 QQ 号（纯数字，不要加引号）
TARGET_QQ=123456789

# true = 只检测并打印将要发送的内容，不真正发送 QQ 消息（首次验证建议设为 true）
DRY_RUN=true

# ---------- 以下是可选项，不填则使用默认值 ----------

# 单次 HTTP 请求超时（毫秒）：Warframestat 请求 / NapCat 请求
HTTP_TIMEOUT_MS=10000
NAPCAT_TIMEOUT_MS=15000

# 去重状态文件路径（相对路径基于项目根目录）
STATE_FILE=data/state.json

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
